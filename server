--! best_server_finder_v3.lua

local HttpService = game:GetService("HttpService")
local TeleportService = game:GetService("TeleportService")
local placeId = game.PlaceId

-- State Variables
local running = false
local scannedServers = 0
local lowestPlayers = math.huge
local bestServerId = nil

-- Configuration
local MIN_PLAYERS_TARGET = 1  -- Find servers with at least 1 player (0 is often empty/new)
local MAX_PAGES_TO_SCAN = 15  -- Scan up to 1500 servers (15 pages * 100 servers)
local SERVER_API_URL = "https://games.roblox.com/v1/games/%d/servers/Public?limit=100&cursor=%s"

--- Utility Functions ---

local function notify(txt)
    -- This function is crucial for feedback, ensure your executor supports SetCore:SendNotification
    game.StarterGui:SetCore("SendNotification", {
        Title = "Best Server Finder";
        Text = txt;
        Duration = 4;
    })
end

--- Data Fetching ---

-- Function to safely fetch and decode one page of server data
local function getServers(cursor)
    local url = SERVER_API_URL:format(placeId, cursor)
    
    local success, response = pcall(function()
        -- Use GetAsync() - If this fails, your executor might be blocking HTTP requests
        return HttpService:GetAsync(url) 
    end)

    if not success then
        warn("HTTP Request Failed:", response)
        notify("❌ Server API Call Failed! Check executor HTTP permissions.")
        return nil, nil
    end

    local data
    local decodeSuccess, decodeErr = pcall(function()
        data = HttpService:JSONDecode(response)
    end)

    if not decodeSuccess then
        warn("JSON Decode Failed:", decodeErr)
        notify("❌ Failed to decode server data.")
        return nil, nil
    end
    
    return data.data, data.nextPageCursor
end

--- Main Server Finding Logic ---

local function scanForBestServer()
    lowestPlayers = math.huge
    bestServerId = nil
    local currentCursor = ""
    local pagesScanned = 0
    
    notify("🔍 Starting deep scan for the quietest server...")
    
    while running and pagesScanned < MAX_PAGES_TO_SCAN do
        local servers, nextCursor = getServers(currentCursor)
        
        if not servers then
            -- getServers already handled the notification
            break 
        end
        
        scannedServers = scannedServers + #servers
        pagesScanned = pagesScanned + 1
        
        for _, server in ipairs(servers) do
            if not running then return end

            local players = server.playing
            local max = server.maxPlayers

            -- Criteria: Server must not be full AND must meet our minimum target (e.g., > 0)
            if players < max and players >= MIN_PLAYERS_TARGET then
                
                -- Check for a NEW low score
                if players < lowestPlayers then
                    lowestPlayers = players
                    bestServerId = server.id
                end
            end
        end

        updateCounter() -- Update UI with new scan count/lowest player count

        if nextCursor and nextCursor ~= "" then
            currentCursor = nextCursor
            -- IMPORTANT: Wait to avoid Roblox API rate limits
            if running then task.wait(0.6) end 
        else
            -- No more pages to scan
            break 
        end
    end
end

local function findServer()
    if running then return end -- Prevent double-clicking
    running = true
    scannedServers = 0
    updateCounter()
    setStartRed() -- Update UI to scanning state

    -- >> NEW: Use task.spawn to run the scan logic concurrently
    task.spawn(function()
        
        scanForBestServer() -- Execute the scan loop

        -- Teleportation Decision
        if bestServerId then
            notify(("✅ Found Best Server: %d players! Teleporting..."):format(lowestPlayers))
            
            setclipboard(bestServerId) -- Copy JobId for debugging/manual entry
            
            -- Teleport
            TeleportService:TeleportToPlaceInstance(placeId, bestServerId)
            
        else
            notify(("🚫 Scan finished. Found no suitable server after checking %d servers."):format(scannedServers))
        end

        running = false
        setStartGreen()
    end) -- End of task.spawn
end

--- Event Connections ---

Start.MouseButton1Click:Connect(findServer) 
